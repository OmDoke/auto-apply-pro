
# Required: Groq API key for AI-powered answer fallback
GROQ_API_KEY=your_groq_api_key_here

# Groq Model: reasoning model to use (default: deepseek-r1-distill-llama-70b)
GROQ_MODEL=deepseek-r1-distill-llama-70b

# LLM First: set to true to prioritize AI model answering over static rules/fuzzy matches
LLM_FIRST=false


# Recommended: Job search preferences
JOB_TITLE=Frontend Developer,Full Stack Developer,Software Engineer
LOCATION=pune

# LinkedIn: exact name of the saved resume to use (must match what's shown in LinkedIn)
RESUME_NAME=resume

# CORS: comma-separated list of allowed frontend origins
ALLOWED_ORIGIN=http://localhost:5173,http://localhost:3000

# Puppeteer: skip bundled Chromium download (set to true if using system Chrome)
PUPPETEER_SKIP_CHROMIUM_DOWNLOAD=true

# Chrome Path: path to your Chrome executable (Windows example below)
CHROME_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe

# User Data: path to a JSON file containing user profile (optional)
# USER_DATA_PATH=./data/user_profile.json
