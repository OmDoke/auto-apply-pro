
# Required: Groq API key for resume tailoring + form Q&A (primary LLM)
GROQ_API_KEY=your_groq_api_key_here

# Groq Model: active model to use (default: openai/gpt-oss-120b)
GROQ_MODEL=openai/gpt-oss-120b

# LLM First: set to true to prioritize AI model answering over static rules/fuzzy matches
LLM_FIRST=false

# Gemini API key — used for job match scoring (fast/cheap bulk JD calls)
# Also acts as fallback for resume tailoring when Groq daily token limit (TPD) is hit
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash

# Recommended: Job search preferences
JOB_TITLE=Frontend Developer,Full Stack Developer,Software Engineer
LOCATION=pune

# LinkedIn: exact name of the saved resume to use (must match what's shown in LinkedIn)
RESUME_NAME=resume

# CORS: comma-separated list of allowed frontend origins
ALLOWED_ORIGIN=http://localhost:5173,http://localhost:3000

# Puppeteer: skip bundled Chromium download (set to true if using system Chrome)
PUPPETEER_SKIP_CHROMIUM_DOWNLOAD=true

# Chrome Path: path to your Chrome executable (Windows example below)
CHROME_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe

# User Data: path to a JSON file containing user profile (optional)
# USER_DATA_PATH=./data/user_profile.json

# ── Screening preferences (set automatically from frontend dashboard) ──────
# These are passed from the UI via sequentialController.js — no need to set manually
# FRONTEND_SKILLS=React,TypeScript,Node.js
# FRONTEND_EXCLUDE_COMPANIES=HT Media,NIIT
# FRONTEND_EXCLUDE_KEYWORDS=Senior,Lead,10+ years
# FRONTEND_MIN_MATCH_SCORE=60
# FRONTEND_JOB_TYPE=any
# FRONTEND_WORK_MODE=any

# ── LinkedIn agent (all optional — defaults shown) ─────────────────────────
# JOB_TITLE above is comma-separated: LinkedIn runs one search per title
# LINKEDIN_EXPERIENCE_LEVELS=1,2          # f_E codes: 1=Internship 2=Entry 3=Associate 4=Mid-Senior
# LINKEDIN_EXCLUDE_COMPANIES=HT Media,HT Labs
# LINKEDIN_DAILY_LIMIT=50                 # max LinkedIn applications per calendar day (all runs)
# MAX_APPLICATIONS=50                     # max per single run
# LINKEDIN_APPLY_GAP_MIN_MS=45000         # random pause after each application
# LINKEDIN_APPLY_GAP_MAX_MS=120000
# LINKEDIN_LONG_BREAK_EVERY=10            # longer break every N applications
# LINKEDIN_LONG_BREAK_MIN_MS=300000
# LINKEDIN_LONG_BREAK_MAX_MS=600000
# LINKEDIN_STRICT_ANSWERS=true            # never guess Yes/first option on required questions
# LINKEDIN_TAILOR_RESUME=true
# LINKEDIN_FOLLOW_COMPANY=false           # untick "Follow company" before submitting
# LINKEDIN_HIDE_AUTOMATION=false          # true = hide automation flags (test login still works first)
# LINKEDIN_MAX_ATTEMPTS=2
# LINKEDIN_MAX_STEPS=20
# RESUME_FILENAME=onkar_resume.pdf        # file name recruiters see for the uploaded resume
